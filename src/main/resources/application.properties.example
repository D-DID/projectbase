spring.application.name=recallcheck

# ============================================================================
# 이 파일은 .gitignore 에 등록되어 있어 git 에 올라가지 않는다.
# 실제 인증키·비밀번호는 여기에만 두고, 팀 공유용 템플릿은
# application.properties.example 을 수정할 것.
# ============================================================================

# ---------------------------------------------------------------- DataSource
spring.datasource.url=jdbc:mysql://localhost:3306/recallcheck?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=여기에_DB_비밀번호
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ---------------------------------------------------------------- JPA
# schema.sql 로 스키마를 만든 뒤에는 validate 로 두어 엔티티와 실제 스키마가 갈라지지 않게 한다.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.show_sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=true
# 리콜 데이터 대량 적재용 배치 설정
spring.jpa.properties.hibernate.jdbc.batch_size=100
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true

# ---------------------------------------------------------------- 파일 업로드 (FR-004)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
app.upload.dir=./uploads

# ---------------------------------------------------------------- JWT
jwt.secret.key=여기에_Base64_인코딩된_32바이트_이상_시크릿
jwt.expiration_time=3600000

# ---------------------------------------------------------------- 국가기술표준원 SafetyKorea Open API (FR-009, FR-016)
# 인증키는 쿼리 파라미터가 아니라 HTTP 헤더 AuthKey 로 전송한다 (대소문자 구분).
# 목록 조회는 페이징 파라미터가 없고 최대 1,000건까지만 응답한다.
openapi.safety-korea.base-url=http://www.safetykorea.kr
openapi.safety-korea.auth-key=여기에_발급받은_서비스ID
openapi.safety-korea.recall-list-path=/openapi/api/recall/recallList.json
openapi.safety-korea.recall-detail-path=/openapi/api/recall/recallDetail.json
openapi.safety-korea.cert-list-path=/openapi/api/cert/certificationList.json
openapi.safety-korea.cert-detail-path=/openapi/api/cert/certificationDetail.json

# ---------------------------------------------------------------- OCR 모듈 (FR-006)
ocr.base-url=http://localhost:8000

# ---------------------------------------------------------------- 매칭 가중치·임계값 (FR-010, FR-011)
# 확정값 아님. 라벨링 데이터셋으로 튜닝한 뒤 이 값만 바꾼다. 코드에 하드코딩 금지.
matching.weight.model-name=0.50
matching.weight.cert-num=0.25
matching.weight.product-name=0.15
matching.weight.maker-name=0.10
matching.threshold.match=0.85
matching.threshold.partial=0.60
